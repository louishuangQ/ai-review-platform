{
  "name": "ai-review-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --host 127.0.0.1 --port 4174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview:local": "npm run build && vite preview --host 127.0.0.1 --port 4174 --strictPort --open",
    "test": "vitest run",
    "lint": "tsc --noEmit --pretty false",
    "format": "prettier --write src package.json .prettierrc.json",
    "format:check": "prettier --check src package.json .prettierrc.json"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "jsdom": "29.1.1",
    "prettier": "3.8.3",
    "vitest": "4.1.11"
  }
}
